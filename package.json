  "version": "1.0.0",
  "description": "Commercial Lifecycle Management System — From commitment to settlement.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
