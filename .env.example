# ==============================================================================
# CLMS CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in the values for your environment.
#
# CRITICAL SECURITY MANDATES:
# 1. ONLY public/publishable browser keys (VITE_*) belong in this file.
# 2. NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or any VITE_* variable.
# 3. NEVER commit .env.local or real credentials to source control.
# ==============================================================================

# Supabase API Gateway URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser delivery, governed by PostgreSQL RLS)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
